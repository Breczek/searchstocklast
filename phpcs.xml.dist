<?xml version="1.0"?>
<ruleset name="Search Stock Last PSR-2">
  <description>PSR-2 coding standard for module and test PHP sources.</description>

  <arg name="colors"/>
  <arg name="extensions" value="php"/>
  <arg value="p"/>

  <file>searchstocklast</file>
  <file>tests</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>

  <rule ref="PSR2"/>

  <!-- PrestaShop requires the main module class to remain global and guarded. -->
  <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
    <exclude-pattern>*/searchstocklast/searchstocklast.php</exclude-pattern>
    <exclude-pattern>*/tests/Fixtures/Product.php</exclude-pattern>
  </rule>
  <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
    <exclude-pattern>*/searchstocklast/searchstocklast.php</exclude-pattern>
  </rule>
</ruleset>
